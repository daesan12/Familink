# Parameter Store 이름만 관리하는 예시 파일입니다.
# 실제 값, 비밀번호, Access Key는 이 파일이나 Git에 넣지 않습니다.

FAMILINK_PARAM_DB_HOST=/familink/prod/DB_HOST
FAMILINK_PARAM_DB_PORT=/familink/prod/DB_PORT
FAMILINK_PARAM_DB_NAME=/familink/prod/DB_NAME
FAMILINK_PARAM_DB_USERNAME=/familink/prod/DB_USERNAME
FAMILINK_PARAM_DB_PASSWORD=/familink/prod/DB_PASSWORD
FAMILINK_PARAM_S3_BUCKET=/familink/prod/S3_BUCKET
FAMILINK_PARAM_AWS_REGION=/familink/prod/AWS_REGION
FAMILINK_PARAM_S3_PRESIGNED_URL_DURATION=/familink/prod/S3_PRESIGNED_URL_DURATION
FAMILINK_PARAM_S3_DOWNLOAD_URL_DURATION=/familink/prod/S3_DOWNLOAD_URL_DURATION
