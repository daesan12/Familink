{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWritePostMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::s15p11b104-media-580779787807-ap-northeast-2-an/post-media/*"
    },
    {
      "Sid": "ReadProductionParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:<AWS_ACCOUNT_ID>:parameter/familink/prod/*"
    },
    {
      "Sid": "DecryptProductionParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "<SSM_KMS_KEY_ARN>"
    }
  ]
}
