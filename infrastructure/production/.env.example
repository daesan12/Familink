SPRING_PROFILES_ACTIVE=prod

# RDS connection. Replace every replace-me value before starting production.
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_NAME=s15p11b104
DB_USERNAME=replace-with-rds-username
DB_PASSWORD=replace-with-rds-password

# Redis stays inside the Compose network; do not change REDIS_HOST to localhost.
REDIS_PASSWORD=replace-with-strong-redis-password
JWT_SECRET=replace-with-long-random-jwt-secret

# Firebase service-account JSON must stay outside the repository.
PUSH_ENABLED=true
FIREBASE_CREDENTIALS_FILE=/opt/familink/secrets/firebase-service-account.json

# Existing private S3 bucket. EC2 IAM role supplies AWS credentials.
S3_BUCKET=s15p11b104-media-580779787807-ap-northeast-2-an
AWS_REGION=ap-northeast-2
S3_ENDPOINT=
S3_ALLOWED_HOSTS=
S3_PRESIGNED_URL_DURATION=10m
S3_DOWNLOAD_URL_DURATION=30m

# Optional external AI credentials. Keep secrets out of Git.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGE=ko
OPENAI_REALTIME_BASE_URL=https://api.openai.com
OPENAI_REALTIME_SIDEBAND_URL=wss://api.openai.com/v1/realtime
GMS_API_KEY=
GMS_API_BASE_URL=https://gms.ssafy.io/gmsapi/generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash
GEMINI_CALL_REPORT_MODEL=gemini-3.5-flash
GEMINI_DAILY_REPORT_MODEL=gemini-3.5-flash

MEDIA_IMAGE_MAX_SIZE_BYTES=10485760
MEDIA_VIDEO_MAX_SIZE_BYTES=104857600
MEDIA_VIDEO_MAX_DURATION_SECONDS=60
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_ALLOWED_VIDEO_TYPES=video/mp4
FFPROBE_PATH=ffprobe

DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1280m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC
BACKEND_IMAGE=familink-backend:local

# CloudWatch Logs groups must exist before production Compose starts.
CLOUDWATCH_BACKEND_LOG_GROUP=/familink/prod/backend
CLOUDWATCH_BACKEND_LOG_STREAM=backend
CLOUDWATCH_NGINX_LOG_GROUP=/familink/prod/nginx
CLOUDWATCH_NGINX_LOG_STREAM=nginx
